function serverA() {
    return new Promise((resolve, reject) => {
        const fail = Math.random() < 0.2;
        setTimeout(() => {
            if (fail) reject("Server A failed");
            else resolve("Server A completed");
        }, 2000);
    });
}

function serverB() {
    return new Promise((resolve, reject) => {
        const fail = Math.random() < 0.2;
        setTimeout(() => {
            if (fail) reject("Server B failed");
            else resolve("Server B completed");
        }, 3000);
    });
}

Promise.all([serverA(), serverB()])
    .then(() => console.log("Deployment completed for all servers"))
    .catch(err => console.log(err));

Promise.race([serverA(), serverB()])
    .then(result => console.log("Fastest response:", result))
    .catch(err => console.log("Fastest failed:", err));
